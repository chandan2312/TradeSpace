# TradeSpace — copy to .env and fill in. See master.md §5 for details.

# ---------- Telegram: Price Alerts & Autonomous Brain ----------
TELEGRAM_BOT_TOKEN=your-price-bot-token
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_BOT_TOKEN_PRICE=your-price-bot-token
TELEGRAM_CHAT_ID_PRICE=-100xxxxxxxxxx

# ---------- Telegram: Currency Algo & Setups Channel ----------
TELEGRAM_BOT_TOKEN_SETUP=your-setup-bot-token
TELEGRAM_CHAT_ID_SETUP=-100xxxxxxxxxx

# ---------- Telegram: Priority / Rated Alerts (2★ / 3★) ----------
TELEGRAM_BOT_TOKEN_PRIORITY=your-priority-bot-token
TELEGRAM_CHAT_ID_PRIORITY=-100xxxxxxxxxx

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/TradeSpace
MONGODB_DB=TradeSpace

# ---------- MT5 bridge (mt5_server.py on the Windows RDP) ----------
NEXUS_MT5_REMOTE_URL=http://your-rdp-ip:8765
NEXUS_MT5_REMOTE_TOKEN=must-match-MT5_TOKEN-on-the-rdp

# ---------- Optional ----------
#PORT=3000
#ALERT_POLL_MS=3000
